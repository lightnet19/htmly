; HTMLy User Account Configuration Template
; Rename this file to <your_username>.ini (e.g., admin.ini) in config/users/

; Plaintext initial password. Will be auto-hashed on first successful login.
password = yourpassword

; Encryption mode: 'clear' for initial setup. Automatically changes to 'password_hash' upon login.
encryption = clear

; User Role: 'admin' (full access), 'editor' (manage content), or 'author' (publish own posts).
role = admin

; Multi-Factor Authentication (2FA/MFA) Secret key.
; Managed automatically in Admin -> Profile, or set to "disabled" to turn off.
mfa_secret = disabled